# Copie para .env e ajuste. O .env nunca vai para o git.

DATABASE_URL=postgres://devdesk:devdesk@localhost:5432/devdesk

# Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# OAuth App do GitHub (github.com/settings/developers → New OAuth App)
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/github/callback
# Sem estes dois, o login com GitHub fica desligado e só o modo demo aparece.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:5173/api
DEMO_ENABLED=true
